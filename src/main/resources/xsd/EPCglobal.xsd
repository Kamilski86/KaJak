<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:epcglobal="urn:epcglobal:xsd:1"
            targetNamespace="urn:epcglobal:xsd:1"
            elementFormDefault="unqualified"
            attributeFormDefault="unqualified">

    <xsd:annotation>
        <xsd:documentation xml:lang="en">
            EPCglobal base schema for EPCIS 1.2
        </xsd:documentation>
    </xsd:annotation>

    <!-- Base document type used by EPCISDocumentType -->
    <xsd:complexType name="Document" abstract="true">
        <xsd:sequence/>
        <xsd:attribute name="creationDate"  type="xsd:dateTime"  use="optional"/>
        <xsd:attribute name="schemaVersion" type="xsd:decimal"   use="optional"/>
        <xsd:anyAttribute processContents="lax"/>
    </xsd:complexType>

    <!-- EPC simple type: any URI -->
    <xsd:simpleType name="EPC">
        <xsd:restriction base="xsd:anyURI"/>
    </xsd:simpleType>

</xsd:schema>
