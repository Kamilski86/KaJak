{
  "info": {
    "name": "EPCIS Event Handler — Phase 4 (CBV + Digital Link)",
    "description": "GS1 Digital Link Resolver und CBV Validator — vollständige Testkollektion für Phase 4.\n\nVoraussetzung: PostgreSQL läuft, App gestartet mit ./mvnw spring-boot:run\n\nC&A Testkonstanten:\n- Company Prefix: 4056019 (7 Stellen)\n- Item Reference: 010532 (6 Stellen)\n- GTIN-14: 40560190105322 (Prüfziffer=2)\n- SSCC-18: 040560190000000018 (Prüfziffer=8)\n- GLN-13: 4056019000001 (Prüfziffer=1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "dlBase",
      "value": "https://id.canda.com",
      "type": "string"
    },
    {
      "key": "gtin14",
      "value": "40560190105322",
      "type": "string"
    },
    {
      "key": "sscc18",
      "value": "040560190000000018",
      "type": "string"
    },
    {
      "key": "gln13",
      "value": "4056019000001",
      "type": "string"
    },
    {
      "key": "serial",
      "value": "12345",
      "type": "string"
    },
    {
      "key": "sgtinUrn",
      "value": "urn:epc:id:sgtin:4056019.010532.12345",
      "type": "string"
    },
    {
      "key": "ssccUrn",
      "value": "urn:epc:id:sscc:4056019.0000000001",
      "type": "string"
    },
    {
      "key": "sglnUrn",
      "value": "urn:epc:id:sgln:4056019.00000.0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Digital Link — Parse",
      "item": [
        {
          "name": "Parse SGTIN (AI 01 + AI 21)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/digitallink/parse?uri={{dlBase}}/01/{{gtin14}}/21/{{serial}}",
              "host": ["{{baseUrl}}"],
              "path": ["digitallink", "parse"],
              "query": [
                {
                  "key": "uri",
                  "value": "{{dlBase}}/01/{{gtin14}}/21/{{serial}}"
                }
              ]
            },
            "description": "Parst einen GS1 Digital Link mit GTIN (AI 01) und Seriennummer (AI 21).\nErwartet: primaryAi=01, primaryKey=gtin, epcUrn=urn:epc:id:sgtin:..."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('primaryAi = 01', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.primaryAi).to.eql('01');",
                  "});",
                  "pm.test('primaryKey = gtin', () => {",
                  "    pm.expect(pm.response.json().primaryKey).to.eql('gtin');",
                  "});",
                  "pm.test('primaryValue = GTIN-14', () => {",
                  "    pm.expect(pm.response.json().primaryValue).to.eql(pm.collectionVariables.get('gtin14'));",
                  "});",
                  "pm.test('qualifier 21 = serial', () => {",
                  "    pm.expect(pm.response.json().qualifiers['21']).to.eql(pm.collectionVariables.get('serial'));",
                  "});",
                  "pm.test('epcUrn present', () => {",
                  "    pm.expect(pm.response.json().epcUrn).to.include('sgtin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Parse SGTIN — Short Name (gtin/ser)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/digitallink/parse?uri={{dlBase}}/gtin/{{gtin14}}/ser/{{serial}}",
              "host": ["{{baseUrl}}"],
              "path": ["digitallink", "parse"],
              "query": [
                {
                  "key": "uri",
                  "value": "{{dlBase}}/gtin/{{gtin14}}/ser/{{serial}}"
                }
              ]
            },
            "description": "Parst einen GS1 Digital Link mit Short Names statt numerischen AIs.\ngtin → 01, ser → 21"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Short name resolved to numeric AI 01', () => {",
                  "    pm.expect(pm.response.json().primaryAi).to.eql('01');",
                  "});",
                  "pm.test('qualifier 21 present', () => {",
                  "    pm.expect(pm.response.json().qualifiers['21']).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
