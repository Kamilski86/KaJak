            "url": {
              "raw": "{{baseUrl}}/digitallink/convert?epc={{sgtinUrn}}&baseUrl={{dlBase}}",
              "host": ["{{baseUrl}}"],
              "path": ["digitallink", "convert"],
              "query": [
