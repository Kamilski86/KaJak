    {
      "name": "Digital Link — Resolve (GS1 Link Sets)",
      "item": [
        {
          "name": "Resolve SGTIN",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/digitallink/resolve?uri={{dlBase}}/01/{{gtin14}}/21/{{serial}}",
              "host": ["{{baseUrl}}"],
              "path": ["digitallink", "resolve"],
              "query": [
                {
                  "key": "uri",
                  "value": "{{dlBase}}/01/{{gtin14}}/21/{{serial}}"
                }
              ]
            },
            "description": "Gibt GS1 Link Sets für ein SGTIN zurück.\nEnthält immer: gs1:epcis Link\nEnthält wenn im Inventory vorhanden: gs1:location Link"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('identifier vorhanden', () => {",
                  "    pm.expect(pm.response.json().identifier).to.exist;",
                  "});",
                  "pm.test('identifierType = SGTIN', () => {",
                  "    pm.expect(pm.response.json().identifierType).to.eql('SGTIN');",
                  "});",
                  "pm.test('linkSets vorhanden', () => {",
                  "    pm.expect(pm.response.json().linkSets).to.be.an('array');",
                  "});",
                  "pm.test('gs1:epcis Link vorhanden', () => {",
                  "    const links = pm.response.json().linkSets",
                  "        .flatMap(ls => ls.links || []);",
                  "    pm.expect(links.some(l => l.linkType === 'gs1:epcis')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Resolve SSCC",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/digitallink/resolve?uri={{dlBase}}/00/{{sscc18}}",
              "host": ["{{baseUrl}}"],
              "path": ["digitallink", "resolve"],
              "query": [
                {
                  "key": "uri",
                  "value": "{{dlBase}}/00/{{sscc18}}"
                }
              ]
            },
            "description": "Gibt GS1 Link Sets für ein SSCC zurück.\nEnthält: Pallet-Link (/inventory/pallet/...)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('identifierType = SSCC', () => {",
                  "    pm.expect(pm.response.json().identifierType).to.eql('SSCC');",
                  "});",
                  "pm.test('Pallet-Link vorhanden', () => {",
                  "    const links = pm.response.json().linkSets",
                  "        .flatMap(ls => ls.links || []);",
                  "    pm.expect(links.some(l => l.href && l.href.includes('/inventory/pallet/'))).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
