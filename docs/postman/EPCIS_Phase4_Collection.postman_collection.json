    {
      "name": "Round-Trip Test",
      "item": [
        {
          "name": "Round-Trip: SGTIN URN → DL → Parse → URN",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Schritt 1: Convert URN → Digital Link",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const dlBase = pm.collectionVariables.get('dlBase');",
                  "const sgtinUrn = pm.collectionVariables.get('sgtinUrn');",
                  "",
                  "pm.sendRequest(",
                  "    `${baseUrl}/digitallink/convert?epc=${encodeURIComponent(sgtinUrn)}&baseUrl=${encodeURIComponent(dlBase)}`,",
                  "    (err, res) => {",
                  "        if (!err && res.code === 200) {",
                  "            const dlUrl = res.json().digitalLinkUrl;",
                  "            pm.collectionVariables.set('_roundTripDlUrl', dlUrl);",
                  "        }",
                  "    }",
                  ");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Round-Trip: epcUrn stimmt überein', () => {",
                  "    const recovered = pm.response.json().epcUrn;",
                  "    const original = pm.collectionVariables.get('sgtinUrn');",
                  "    pm.expect(recovered).to.eql(original);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/digitallink/parse?uri={{_roundTripDlUrl}}",
              "host": ["{{baseUrl}}"],
              "path": ["digitallink", "parse"],
              "query": [
                { "key": "uri", "value": "{{_roundTripDlUrl}}" }
              ]
            },
            "description": "Vollständiger Round-Trip:\n1. Pre-request Script: SGTIN URN → Digital Link (convert)\n2. Request: Digital Link → parse → epcUrn\n3. Test: epcUrn === ursprüngliche URN"
          },
          "response": []
        }
      ]
    }
